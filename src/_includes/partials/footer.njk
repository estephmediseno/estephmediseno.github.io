<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>{{ site.name }} · {{ site.city }}</p>
    <p>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      ·
      <a href="{{ site.instagram }}">{{ site.instagramHandle }}</a>
    </p>
    <p class="fine">
      {% if lang == 'en' %}
        Copy lives in <code>src/es</code> and <code>src/en</code>. Numbers live in <code>src/_data/metrics</code>.
      {% else %}
        Los textos viven en <code>src/es</code> y <code>src/en</code>. Los números viven en <code>src/_data/metrics</code>.
      {% endif %}
    </p>
  </div>
</footer>
